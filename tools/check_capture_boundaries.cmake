# Also runnable without Python: cmake -DFLORA_SOURCE_ROOT=... -P this-file.
if(NOT DEFINED FLORA_SOURCE_ROOT)
  get_filename_component(FLORA_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
foreach(layer format capture)
  file(GLOB_RECURSE sources "${FLORA_SOURCE_ROOT}/src/${layer}/*.h" "${FLORA_SOURCE_ROOT}/src/${layer}/*.hpp" "${FLORA_SOURCE_ROOT}/src/${layer}/*.cpp")
  foreach(source IN LISTS sources)
    file(READ "${source}" contents)
    string(REGEX MATCHALL "#[ \t]*include[ \t]*[<\"][^>\"\r\n]+" includes "${contents}")
    foreach(header IN LISTS includes)
      if(header MATCHES "(core/|replay/|application/|app/|[Rr]ender[Dd]oc|original_capture_control|gpa_native)")
        message(FATAL_ERROR "Forbidden ${layer} dependency: ${source}: ${header}")
      endif()
      if(source MATCHES "/capture/(encoder|model)/" AND header MATCHES "(runtime/|metadata|registry|context_state|command_stream|capture_session|frame_start|resource_data|d3dcompiler|wrl/|format/Reader)")
        message(FATAL_ERROR "CPU capture model/encoder depends on runtime: ${source}: ${header}")
      endif()
      if(layer STREQUAL "format" AND header MATCHES "(capture/|[Dd]3[Dd]|[Dd][Xx][Gg][Ii]|[Qq][Tt])")
        message(FATAL_ERROR "Format depends on runtime: ${source}: ${header}")
      endif()
      if(source MATCHES "/capture/hud/" AND header MATCHES "(protocol|runtime/|encoder|capture_model|format/|metadata|objects|command_stream|capture_session)")
        message(FATAL_ERROR "HUD depends on capture recording or file format: ${source}: ${header}")
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(layer core replay application)
  file(GLOB_RECURSE sources "${FLORA_SOURCE_ROOT}/src/${layer}/*.h" "${FLORA_SOURCE_ROOT}/src/${layer}/*.cpp")
  foreach(source IN LISTS sources)
    file(READ "${source}" contents)
    if(contents MATCHES "#[ \t]*include[ \t]*[<\"][^>\"\r\n]*(capture/|format/Writer.h)")
      message(FATAL_ERROR "Replay depends on capture/writer: ${source}")
    endif()
  endforeach()
endforeach()
message(STATUS "Capture/format/replay source boundaries passed")

# Configure-time transitive target check. System libraries are leaves.
function(flora_check_capture_target target)
  set(pending "${target}")
  set(visited "")
  while(pending)
    list(POP_FRONT pending current)
    if(current IN_LIST visited OR NOT TARGET "${current}")
      continue()
    endif()
    list(APPEND visited "${current}")
    if(current MATCHES "^(Qt[56]::|Flora(Core|Replay|Experiment|Rdc|Metrics|Hlsl))")
      message(FATAL_ERROR "Forbidden capture dependency from ${target}: ${current}")
    endif()
    if(target STREQUAL "FloraCaptureEncoder" AND current MATCHES "^(FloraCapture(Runtime|Objects)|FloraGpaReader|d3d11|dxgi)$")
      message(FATAL_ERROR "Encoder depends on runtime/reader/GPU execution: ${current}")
    endif()
    if(target STREQUAL "FloraCaptureHud" AND current MATCHES "^(FloraCapture(Runtime|Objects|Encoder|Model)|FloraGpa.*|capture_protocol)$")
      message(FATAL_ERROR "HUD depends on recording/protocol/format: ${current}")
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(deps "${current}" ${property})
      if(deps)
        foreach(dep IN LISTS deps)
          string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" dep "${dep}")
          list(APPEND pending "${dep}")
        endforeach()
      endif()
    endforeach()
  endwhile()
endfunction()
