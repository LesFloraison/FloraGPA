string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${OUTPUT}/${suffix}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${PROBE}" "${root}/native" native RESULT_VARIABLE code TIMEOUT 30)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Native object oracle failed (${code}); see ${root}/native")
endif()
execute_process(COMMAND "${CONTROLLER}" launch --exe "${PROBE}" --out "${root}/session" -- "${root}/injected" injected
  RESULT_VARIABLE code OUTPUT_VARIABLE launch ERROR_VARIABLE errors TIMEOUT 25)
file(WRITE "${root}/launch.json" "${launch}")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Object oracle launch failed: ${launch} ${errors}")
endif()
set(ready FALSE)
foreach(attempt RANGE 1 400)
  if(EXISTS "${root}/injected/ready.json")
    set(ready TRUE)
    break()
  endif()
  if(EXISTS "${root}/injected/error.json")
    break()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.05)
endforeach()
execute_process(COMMAND "${CONTROLLER}" status --session "${root}/session/session.json"
  RESULT_VARIABLE code OUTPUT_VARIABLE status TIMEOUT 10)
file(WRITE "${root}/status.json" "${status}")
file(WRITE "${root}/injected/finish.signal" "")
if(NOT ready OR NOT code EQUAL 0)
  message(FATAL_ERROR "Injected object oracle failed; see ${root}")
endif()
file(READ "${root}/native/ready.json" native)
file(READ "${root}/injected/ready.json" injected)
if(NOT native STREQUAL injected)
  message(FATAL_ERROR "Native/injected object oracle mismatch; see ${root}")
endif()
string(JSON gaps GET "${status}" objects interface_gaps)
string(JSON active GET "${status}" objects active)
string(JSON created GET "${status}" objects created)
string(JSON destroyed GET "${status}" objects destroyed)
if(NOT gaps EQUAL 0 OR NOT active EQUAL 0 OR created EQUAL 0 OR NOT created EQUAL destroyed)
  message(FATAL_ERROR "Object registry gaps or leaked application objects; see ${root}/status.json")
endif()
string(JSON modules GET "${status}" loaded_modules)
string(TOLOWER "${modules}" modules)
if(modules MATCHES "intelswtools|qt6|python3|renderdoc|floragpa.worker")
  message(FATAL_ERROR "Capture runtime loaded an unrelated product dependency; see ${root}/status.json")
endif()
message(STATUS "Native/injected D3D11 object oracle passed; ${created} object lifetimes, no frame capture claimed")
