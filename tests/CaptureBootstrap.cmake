if(NOT DEFINED CONTROLLER OR NOT DEFINED PROBE OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "Expected CONTROLLER, PROBE and OUTPUT")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${OUTPUT}/${suffix}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${CONTROLLER}" launch --exe "${PROBE}" --out "${root}/session" -- "${root}/oracle" 1
  RESULT_VARIABLE code OUTPUT_VARIABLE launch ERROR_VARIABLE errors TIMEOUT 25)
file(WRITE "${root}/launch.json" "${launch}")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Launch failed: ${launch} ${errors}")
endif()
set(ready FALSE)
foreach(attempt RANGE 1 200)
  if(EXISTS "${root}/oracle/ready.json")
    set(ready TRUE)
    break()
  endif()
  if(EXISTS "${root}/oracle/error.json")
    file(READ "${root}/oracle/error.json" errors)
    message(FATAL_ERROR "Oracle failed: ${errors}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.05)
endforeach()
if(NOT ready)
  message(FATAL_ERROR "Oracle did not become ready")
endif()
set(failures "")
foreach(command status capture cancel disconnect)
  execute_process(COMMAND "${CONTROLLER}" ${command} --session "${root}/session/session.json"
    RESULT_VARIABLE code OUTPUT_VARIABLE result TIMEOUT 10)
  file(WRITE "${root}/${command}.json" "${result}")
  if(command STREQUAL "capture")
    string(JSON reason ERROR_VARIABLE parseError GET "${result}" error)
    if(NOT code EQUAL 3 OR parseError OR NOT reason STREQUAL "capture_capability_incomplete")
      list(APPEND failures "Capture did not reject incomplete recording: ${result}")
    endif()
  elseif(NOT code EQUAL 0)
    list(APPEND failures "${command} failed: ${result}")
  endif()
endforeach()
# The oracle owns the process and exits on this signal; disconnect must not kill it.
file(WRITE "${root}/oracle/finish.signal" "")
if(failures)
  message(FATAL_ERROR "${failures}")
endif()
message(STATUS "Native launch/status/refusal/cancel/disconnect passed; no frame capture claimed")
