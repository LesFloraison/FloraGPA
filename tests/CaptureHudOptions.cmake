foreach(case mode duplicate invalid disabled_modifier)
  set(options --hud compact)
  set(expected "")
  if(case STREQUAL "mode")
    set(options --hud unknown)
    set(expected "HUD mode")
  elseif(case STREQUAL "duplicate")
    set(options --hud-hotkey Ctrl+Shift+C --capture-hotkey Shift+Ctrl+C)
    set(expected "must differ")
  elseif(case STREQUAL "invalid")
    set(options --capture-hotkey Ctrl+F25)
    set(expected "Invalid function key")
  else()
    set(options --hud-hotkey Ctrl)
    set(expected "requires a modifier and a key")
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(destination "${OUTPUT}/${nonce}")
  execute_process(COMMAND "${CONTROLLER}" launch --exe nonexistent.exe --out "${destination}" ${options}
    RESULT_VARIABLE result OUTPUT_VARIABLE response ERROR_VARIABLE error TIMEOUT 20)
  if(NOT result EQUAL 2 OR NOT response MATCHES "${expected}" OR EXISTS "${destination}")
    message(FATAL_ERROR "HUD option ${case} did not reject before launch: ${result}: ${response}: ${error}")
  endif()
endforeach()
message(STATUS "Malformed/conflicting HUD options reject before filesystem mutation or launch")
