* text=auto eol=lf
*.png binary
*.ico binary
*.exe binary
*.dll binary
# Preserve the extracted shader bytes and their provenance hash.
src/application/shaders/quad_counter.hlsl -text whitespace=cr-at-eol
# Preserve upstream replay-header whitespace for source/hash comparisons.
third_party/renderdoc/replay/*.h whitespace=-blank-at-eol
# Unified diffs retain a leading context space on empty lines.
third_party/renderdoc/patches/*.patch whitespace=-blank-at-eol
# Preserve pinned Intel public interface bytes for provenance comparisons.
third_party/metrics-discovery/* -text whitespace=-blank-at-eol

# Keep upstream runtime notice bytes identical to the pinned manifest.
third_party/renderdoc/runtime-licenses/** -text whitespace=-blank-at-eol
# Capture dependency hashes cover the original upstream bytes, including CRLF.
third_party/detours/** -text whitespace=-blank-at-eol
# Keep DXC release notices identical to the pinned manifest.
third_party/dxc/LICENSE-*.txt -text whitespace=-blank-at-eol
