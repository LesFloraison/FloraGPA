{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "capture-only",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/capture",
      "cacheVariables": {
        "FLORA_BUILD_REPLAY": "OFF",
        "FLORA_BUILD_CAPTURE": "ON",
        "FLORA_BUILD_CAPTURE_UI": "OFF"
      }
    },
    {
      "name": "replay-only",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/replay",
      "cacheVariables": {
        "FLORA_BUILD_REPLAY": "ON",
        "FLORA_BUILD_CAPTURE": "OFF",
        "FLORA_BUILD_CAPTURE_UI": "OFF"
      }
    },
    {
      "name": "capture-full",
      "inherits": "vs2022",
      "binaryDir": "${sourceDir}/build/vs2022",
      "cacheVariables": {
        "FLORA_BUILD_REPLAY": "ON",
        "FLORA_BUILD_CAPTURE": "ON",
        "FLORA_BUILD_CAPTURE_UI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    },
    {
      "name": "capture-only-release",
      "configurePreset": "capture-only",
      "configuration": "Release"
    },
    {
      "name": "replay-only-release",
      "configurePreset": "replay-only",
      "configuration": "Release"
    },
    {
      "name": "capture-full-release",
      "configurePreset": "capture-full",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2022",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "capture-only-release",
      "configurePreset": "capture-only",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "replay-only-release",
      "configurePreset": "replay-only",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "capture-full-release",
      "configurePreset": "capture-full",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1
      }
    }
  ]
}
