@@ -706,13 +706,36 @@
 D3D12APIWrapper::~D3D12APIWrapper()
 {
   CHECK_DEVICE_THREAD();
+  m_RetainComputeInputs = false;
   ResetReplay();
+}
+
+static std::atomic<bool> floraRetainComputeInputs(false);
+static std::atomic<uint64_t> floraRetainedComputeTraces(0);
+extern "C" RENDERDOC_API uint32_t RENDERDOC_CC RENDERDOC_GetFloraRetainedComputePatchVersion() { return 1; }
+extern "C" RENDERDOC_API void RENDERDOC_CC RENDERDOC_SetFloraRetainedComputeEnabled(bool value) { floraRetainComputeInputs = value; }
+extern "C" RENDERDOC_API uint64_t RENDERDOC_CC RENDERDOC_GetFloraRetainedComputeTraces() { return floraRetainedComputeTraces.load(); }
+
+void D3D12APIWrapper::RetainComputeInputs()
+{
+  CHECK_DEVICE_THREAD();
+  if(floraRetainComputeInputs.load())
+  {
+    // DebugThread has replayed WithoutDraw and its lane fetcher writes only debug resources.
+    // Keep those application inputs until the wrapper is destroyed. Replaying the prefix
+    // again can regenerate a different indirect work list for the same Group/Thread ID.
+    m_ResourcesDirty = false;
+    m_RetainComputeInputs = true;
+    ++floraRetainedComputeTraces;
+  }
 }
 
 // Must be called from the replay manager thread (the debugger thread)
 void D3D12APIWrapper::ResetReplay()
 {
   CHECK_DEVICE_THREAD();
+  if(m_RetainComputeInputs)
+    return;
   if(!m_ResourcesDirty)
   {
     // replay the action to get back to 'normal' state for this event
