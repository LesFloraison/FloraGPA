+// One explicitly requested local D3D12 DXIL debug preparation. Tokens are
+// consumed only by this driver's exact event, or invalidated on another selection.
+static thread_local bool floraPrepareComputeNext = false;
+static thread_local IReplayDriver *floraPreparedComputeDriver = NULL;
+static thread_local uint32_t floraPreparedComputeEvent = 0;
+static thread_local uint64_t floraPreparedComputeConsumed = 0;
+bool FloraConsumePreparedCompute(IReplayDriver *driver, uint32_t eventId)
+{
+  const bool match = driver == floraPreparedComputeDriver && eventId == floraPreparedComputeEvent;
+  floraPreparedComputeDriver = NULL;
+  floraPreparedComputeEvent = 0;
+  if(match) ++floraPreparedComputeConsumed;
+  return match;
+}
+extern "C" RENDERDOC_API uint32_t RENDERDOC_CC RENDERDOC_GetFloraPreparedComputePatchVersion() { return 1; }
+extern "C" RENDERDOC_API uint64_t RENDERDOC_CC RENDERDOC_GetFloraPreparedComputeConsumed() { return floraPreparedComputeConsumed; }
+extern "C" RENDERDOC_API uint32_t RENDERDOC_CC RENDERDOC_PrepareFloraComputeDebug(IReplayController *controller, uint32_t eventId)
+{
+  if(!controller) return 0;
+  floraPrepareComputeNext = true;
+  controller->SetFrameEvent(eventId, true);
+  return floraPreparedComputeDriver ? 1 : 2;
+}
+
 void ReplayController::SetFrameEvent(uint32_t eventId, bool force)
 {
   CHECK_REPLAY_THREAD();
+  const bool prepareCompute = floraPrepareComputeNext;
+  floraPrepareComputeNext = false;
+  floraPreparedComputeDriver = NULL;
+  floraPreparedComputeEvent = 0;
   RENDERDOC_PROFILEFUNCTION();
 
   // use remapped event if there's a match
@@ -87,6 +115,18 @@
 
     for(size_t i = 0; i < m_Outputs.size(); i++)
       m_Outputs[i]->SetFrameEvent(eventId);
+
+    if(prepareCompute && m_APIProps.pipelineType == GraphicsAPI::D3D12 && m_Outputs.empty())
+    {
+      FetchPipelineState(eventId);
+      const ShaderReflection *cs = m_D3D12PipelineState.computeShader.reflection;
+      if(cs && cs->encoding == ShaderEncoding::DXIL)
+      {
+        floraPreparedComputeDriver = m_pDevice;
+        floraPreparedComputeEvent = eventId;
+        return;
+      }
+    }
 
     m_pDevice->ReplayLog(eventId, eReplay_OnlyDraw);
     FatalErrorCheck();
