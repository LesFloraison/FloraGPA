 };    // namespace DXILDebug
+
+extern "C" RENDERDOC_API uint32_t RENDERDOC_CC RENDERDOC_GetFloraDxilTextureStoresPatchVersion() { return 1; }
+extern "C" RENDERDOC_API uint32_t RENDERDOC_CC RENDERDOC_GetFloraDxilTextureStoreCount(ShaderDebugger *trace)
+{
+  if(!trace || !((DXBCContainerDebugger *)trace)->isDXIL) return 0;
+  auto *debugger = (DXILDebug::Debugger *)trace;
+  return debugger->floraTextureStoresOverflow ? ~0U : uint32_t(debugger->floraTextureStores.size());
+}
+extern "C" RENDERDOC_API bool RENDERDOC_CC RENDERDOC_GetFloraDxilTextureStore(ShaderDebugger *trace, uint32_t index, uint32_t *words, uint32_t count)
+{
+  if(!trace || !words || count != 32 || !((DXBCContainerDebugger *)trace)->isDXIL) return false;
+  auto *debugger = (DXILDebug::Debugger *)trace;
+  if(index >= debugger->floraTextureStores.size()) return false;
+  memcpy(words, debugger->floraTextureStores[index].data(), 32 * sizeof(uint32_t));
+  return true;
+}
