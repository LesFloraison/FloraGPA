+  bool OverlapsSelectedSubresource(const D3D12_RENDER_TARGET_VIEW_DESC &view) const
+  {
+    const Subresource &sub = m_CallbackInfo.targetSubresource;
+    switch(view.ViewDimension)
+    {
+      case D3D12_RTV_DIMENSION_TEXTURE2D:
+        return sub.mip == view.Texture2D.MipSlice && sub.slice == 0;
+      case D3D12_RTV_DIMENSION_TEXTURE2DARRAY:
+        return sub.mip == view.Texture2DArray.MipSlice &&
+               sub.slice >= view.Texture2DArray.FirstArraySlice &&
+               sub.slice - view.Texture2DArray.FirstArraySlice < view.Texture2DArray.ArraySize;
+      case D3D12_RTV_DIMENSION_TEXTURE2DMS: return sub.mip == 0 && sub.slice == 0;
+      case D3D12_RTV_DIMENSION_TEXTURE2DMSARRAY:
+        return sub.mip == 0 && sub.slice >= view.Texture2DMSArray.FirstArraySlice &&
+               sub.slice - view.Texture2DMSArray.FirstArraySlice < view.Texture2DMSArray.ArraySize;
+      default: return true;    // Unknown layouts remain candidates, never silently omitted.
+    }
+  }
+
+  bool OverlapsSelectedSubresource(const D3D12_DEPTH_STENCIL_VIEW_DESC &view) const
+  {
+    const Subresource &sub = m_CallbackInfo.targetSubresource;
+    switch(view.ViewDimension)
+    {
+      case D3D12_DSV_DIMENSION_TEXTURE2D:
+        return sub.mip == view.Texture2D.MipSlice && sub.slice == 0;
+      case D3D12_DSV_DIMENSION_TEXTURE2DARRAY:
+        return sub.mip == view.Texture2DArray.MipSlice &&
+               sub.slice >= view.Texture2DArray.FirstArraySlice &&
+               sub.slice - view.Texture2DArray.FirstArraySlice < view.Texture2DArray.ArraySize;
+      case D3D12_DSV_DIMENSION_TEXTURE2DMS: return sub.mip == 0 && sub.slice == 0;
+      case D3D12_DSV_DIMENSION_TEXTURE2DMSARRAY:
+        return sub.mip == 0 && sub.slice >= view.Texture2DMSArray.FirstArraySlice &&
+               sub.slice - view.Texture2DMSArray.FirstArraySlice < view.Texture2DMSArray.ArraySize;
+      default: return true;
+    }
+  }
+
+  bool HasOverlappingAttachment(const D3D12RenderState &state) const
+  {
+    const ResourceId target = GetResID(m_CallbackInfo.targetImage);
+    bool found = false;
+    for(const D3D12Descriptor &rt : state.rts)
+    {
+      if(rt.GetResResourceId() != target)
+        continue;
+      found = true;
+      if(OverlapsSelectedSubresource(rt.GetRTV()))
+        return true;
+    }
+    if(state.dsv.GetResResourceId() == target)
+    {
+      found = true;
+      if(OverlapsSelectedSubresource(state.dsv.GetDSV()))
+        return true;
+    }
+    // UAV/unknown targets are not proven absent by an attachment-range check.
+    return !found;
+  }
