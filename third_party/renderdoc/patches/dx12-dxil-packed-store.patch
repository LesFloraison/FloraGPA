+// D3D floating-point format conversion rounds toward zero. Going through half
+// first rounds some inputs upward before truncating and can overflow to INF.
+static uint32_t FloraUnsignedFloatRTZ(uint32_t bits, uint32_t fractionBits)
+{
+  const uint32_t exponent = (bits >> 23) & 0xff;
+  const uint32_t fraction = bits & 0x7fffff;
+  const uint32_t infinity = 31U << fractionBits;
+  if(exponent == 0xff && fraction)
+    return infinity | (1U << (fractionBits - 1)); // NaN payload is not prescribed.
+  if(bits & 0x80000000)
+    return 0;
+  if(exponent == 0xff)
+    return infinity;
+  const int32_t targetExponent = int32_t(exponent) - 127 + 15;
+  if(targetExponent >= 31)
+    return infinity - 1; // Finite overflow saturates to the largest finite value.
+  if(targetExponent <= 0)
+  {
+    const uint32_t shift = uint32_t(24 - int32_t(fractionBits) - targetExponent);
+    return shift >= 32 ? 0 : (fraction | 0x800000) >> shift;
+  }
+  return (uint32_t(targetExponent) << fractionBits) | (fraction >> (23 - fractionBits));
+}
