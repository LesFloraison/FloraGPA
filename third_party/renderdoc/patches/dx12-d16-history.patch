+  // D16 copies retain UNORM storage bits, including for typeless backing resources.
+  // The generic two-byte Depth/Typeless component decoder treats these as half floats.
+  if(depthFormat == DXGI_FORMAT_D16_UNORM || depthFormat == DXGI_FORMAT_R16_TYPELESS ||
+     depthFormat == DXGI_FORMAT_R16_UNORM)
+    return float(value.depth.udepth & 0xffff) / 65535.0f;
   FloatVector v4 = DecodeFormattedComponents(MakeResourceFormat(depthFormat), (byte *)&value.depth);
   return v4.x;
 }
