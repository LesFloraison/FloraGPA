+++ b/renderdoc/driver/shaders/dxil/dxil_debug.h
@@ -252,8 +252,17 @@
 
   ResourceInfo resInfo;
 
-  uint32_t rowPitch = 0;
-  uint32_t depthPitch = 0;
+  uint64_t rowPitch = 0;
+  uint64_t depthPitch = 0;
+  uint32_t width = 0, height = 0, depth = 0;
+  bool TexelOffset(const uint32_t coords[3], uint32_t stride, uint64_t &offset) const
+  {
+    if(coords[0] >= width || coords[1] >= height || coords[2] >= depth)
+      return false;
+    offset = uint64_t(coords[0]) * stride + uint64_t(coords[1]) * rowPitch +
+             uint64_t(coords[2]) * depthPitch;
+    return offset <= resInfo.dataSize && stride <= resInfo.dataSize - offset;
+  }
   uint32_t hiddenCounter = 0;
   bool tex = false;
 };
