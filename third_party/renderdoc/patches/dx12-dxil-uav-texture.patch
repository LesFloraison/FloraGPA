+          case D3D12_UAV_DIMENSION_TEXTURE1D: mip = uavDesc.Texture1D.MipSlice; break;
+          case D3D12_UAV_DIMENSION_TEXTURE1DARRAY:
+            mip = uavDesc.Texture1DArray.MipSlice;
+            firstSlice = uavDesc.Texture1DArray.FirstArraySlice;
+            slices = uavDesc.Texture1DArray.ArraySize;
+            break;
+          case D3D12_UAV_DIMENSION_TEXTURE2D:
+            mip = uavDesc.Texture2D.MipSlice; plane = uavDesc.Texture2D.PlaneSlice; break;
