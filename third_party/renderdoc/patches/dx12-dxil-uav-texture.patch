+          return UAVInfo();
+        }
+        const uint32_t available = volume ? RDCMAX(1U, uint32_t(resDesc.DepthOrArraySize) >> mip)
+                                          : resDesc.DepthOrArraySize;
+        if(slices == ~0U && firstSlice < available) slices = available - firstSlice;
+        if(firstSlice >= available || slices == 0 || slices > available - firstSlice)
+        {
