+          if(allSlices.size() != sliceBytes * available)
+          {
+            ++floraUavTextureFailures;
+            return UAVInfo();
+          }
+          data.assign(allSlices.data() + firstSlice * sliceBytes, slices * sliceBytes);
+        }
+        else
+        {
+          for(uint32_t slice = 0; slice < slices; ++slice)
+          {
+            bytebuf layer;
+            m_Device->GetReplay()->GetTextureData(uavId, Subresource(mip, firstSlice + slice, 0), GetTextureDataParams(), layer);
