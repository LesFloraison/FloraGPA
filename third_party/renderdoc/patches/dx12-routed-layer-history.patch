+  void PrepareSelectedLayerMask(ID3D12GraphicsCommandListX *cmd)
+  {
+    D3D12_CPU_DESCRIPTOR_HANDLE handle = m_pDevice->GetDebugManager()->GetCPUHandle(PIXEL_HISTORY_DSV);
+    D3D12_DEPTH_STENCIL_VIEW_DESC full = m_CallbackInfo.dsDescriptor->GetDSV();
+    D3D12_DEPTH_STENCIL_VIEW_DESC selected = full;
+    D3D12_RECT pixel = {(LONG)m_CallbackInfo.x, (LONG)m_CallbackInfo.y,
+                        (LONG)m_CallbackInfo.x + 1, (LONG)m_CallbackInfo.y + 1};
+    cmd->ClearDepthStencilView(handle, D3D12_CLEAR_FLAG_STENCIL, 0.0f, 0, 1, &pixel);
+    if(selected.ViewDimension == D3D12_DSV_DIMENSION_TEXTURE2DARRAY)
+    {
+      selected.Texture2DArray.FirstArraySlice = m_CallbackInfo.targetSubresource.slice;
+      selected.Texture2DArray.ArraySize = 1;
+    }
+    else if(selected.ViewDimension == D3D12_DSV_DIMENSION_TEXTURE2DMSARRAY)
+    {
+      selected.Texture2DMSArray.FirstArraySlice = m_CallbackInfo.targetSubresource.slice;
+      selected.Texture2DMSArray.ArraySize = 1;
+    }
+    // CPU RTV/DSV descriptors are consumed when recording each command.
+    m_pDevice->CreateDepthStencilView(m_CallbackInfo.dsImage, &selected, handle);
+    cmd->ClearDepthStencilView(handle, D3D12_CLEAR_FLAG_STENCIL, 0.0f, 1, 1, &pixel);
+    m_pDevice->CreateDepthStencilView(m_CallbackInfo.dsImage, &full, handle);
   }
 
