+  void ConfigureScratchViews(const D3D12RenderState &state)
+  {
+    if(m_CallbackInfo.targetDesc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+       m_CallbackInfo.targetDesc.DepthOrArraySize <= 1)
+      return;
+
+    const Subresource &sub = m_CallbackInfo.targetSubresource;
+    UINT first = sub.slice, count = 1;
+    const ResourceId target = GetResID(m_CallbackInfo.targetImage);
+    for(const D3D12Descriptor &rt : state.rts)
+    {
+      if(rt.GetResResourceId() != target || !OverlapsSelectedSubresource(rt.GetRTV(), true))
+        continue;
+      const D3D12_RENDER_TARGET_VIEW_DESC &view = rt.GetRTV();
+      if(view.ViewDimension == D3D12_RTV_DIMENSION_TEXTURE2DARRAY)
+      {
+        first = view.Texture2DArray.FirstArraySlice;
+        count = view.Texture2DArray.ArraySize;
+      }
+      else if(view.ViewDimension == D3D12_RTV_DIMENSION_TEXTURE2DMSARRAY)
+      {
+        first = view.Texture2DMSArray.FirstArraySlice;
+        count = view.Texture2DMSArray.ArraySize;
+      }
+      else if(view.ViewDimension == D3D12_RTV_DIMENSION_UNKNOWN && view.Format == DXGI_FORMAT_UNKNOWN)
+      {
+        first = 0;
+        count = m_CallbackInfo.targetDesc.DepthOrArraySize;
+      }
+      break;
+    }
+    if(state.dsv.GetResResourceId() == target)
+    {
+      const D3D12_DEPTH_STENCIL_VIEW_DESC &view = state.dsv.GetDSV();
+      if(view.ViewDimension == D3D12_DSV_DIMENSION_TEXTURE2DARRAY)
+      {
+        first = view.Texture2DArray.FirstArraySlice;
+        count = view.Texture2DArray.ArraySize;
+      }
+      else if(view.ViewDimension == D3D12_DSV_DIMENSION_TEXTURE2DMSARRAY)
+      {
+        first = view.Texture2DMSArray.FirstArraySlice;
+        count = view.Texture2DMSArray.ArraySize;
+      }
+      else if(view.ViewDimension == D3D12_DSV_DIMENSION_UNKNOWN && view.Format == DXGI_FORMAT_UNKNOWN)
+      {
+        first = 0;
+        count = m_CallbackInfo.targetDesc.DepthOrArraySize;
+      }
+    }
+
+    // SV_RenderTargetArrayIndex is relative to the attachment view. A selected-
+    // layer-only scratch view changes that routing (single-layer views can ignore
+    // the index). Preserve the original first layer and count on every Draw.
+    D3D12_RENDER_TARGET_VIEW_DESC rtv = m_CallbackInfo.typedColorDescriptor->GetRTV();
+    D3D12_DEPTH_STENCIL_VIEW_DESC dsv = m_CallbackInfo.dsDescriptor->GetDSV();
+    if(m_CallbackInfo.targetDesc.SampleDesc.Count > 1)
+    {
+      rtv.Texture2DMSArray.FirstArraySlice = dsv.Texture2DMSArray.FirstArraySlice = first;
+      rtv.Texture2DMSArray.ArraySize = dsv.Texture2DMSArray.ArraySize = count;
+    }
+    else
+    {
+      rtv.Texture2DArray.FirstArraySlice = dsv.Texture2DArray.FirstArraySlice = first;
+      rtv.Texture2DArray.ArraySize = dsv.Texture2DArray.ArraySize = count;
+    }
+    D3D12DebugManager *debug = m_pDevice->GetDebugManager();
+    m_pDevice->CreateDepthStencilView(m_CallbackInfo.dsImage, &dsv, debug->GetCPUHandle(PIXEL_HISTORY_DSV));
+    m_pDevice->CreateRenderTargetView(m_CallbackInfo.colorImage, &rtv, debug->GetCPUHandle(PIXEL_HISTORY_TYPED_RTV));
+    rtv.Format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    m_pDevice->CreateRenderTargetView(m_CallbackInfo.colorImage, &rtv, debug->GetCPUHandle(PIXEL_HISTORY_FLOAT_RTV));
+    if(m_CallbackInfo.postModImage)
+    {
+      rtv.Format = m_CallbackInfo.targetDesc.Format;
+      m_pDevice->CreateRenderTargetView(m_CallbackInfo.postModImage, &rtv, m_CallbackInfo.postModRtv);
+    }
+  }
